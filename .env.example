# ==========================================
# ZeroVault Root Environment Configuration
# ==========================================

# Database URLs (PostgreSQL / Supabase)
# DATABASE_URL: Transaction pooler mode (port 6543) or direct connection
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&pgbouncer=true"
# DIRECT_URL: Direct / Session pooler mode (port 5432) required for Prisma migrations
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Application Secrets
JWT_SECRET="your_long_random_jwt_secret_min_32_characters"
CSRF_SECRET="your_random_csrf_secret_min_16_characters"

# Web3 / Smart Contract Configuration
# Deployed ZeroVault contract address on Sepolia or Localhost
ZEROVAULT_CONTRACT_ADDRESS="0xd99501e8a7CE41fFb1DdEF4ca288B57Cf9966091"
# Sepolia JSON-RPC URL (Alchemy, Infura, QuickNode, or public RPC)
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key"
SEPOLIA_RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key"

# Deployment / Contract Verification (Optional)
DEPLOYER_PRIVATE_KEY="your_deployer_private_key_without_0x_or_with_0x"
ETHERSCAN_API_KEY="your_etherscan_api_key"

# Environment & CORS
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"
