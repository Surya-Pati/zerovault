{
	"info": {
		"_postman_id": "7b8f9e01-3d2a-4a8b-9e4f-123456789abc",
		"name": "ZeroVault API Integration Test Suite",
		"description": "Comprehensive automated integration test collection for the ZeroVault Express.js API gateway, testing authentication, CSRF, listings CRUD, and security boundaries.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
