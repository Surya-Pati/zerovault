# ==========================================
# ZeroVault Backend Environment Configuration
# ==========================================

# PostgreSQL Connection Strings
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?sslmode=require"

# Auth & CSRF
JWT_SECRET="your_long_random_jwt_secret_min_32_characters"
CSRF_SECRET="your_random_csrf_secret_min_16_characters"

# Web3 Bridge
ZEROVAULT_CONTRACT_ADDRESS="0xd99501e8a7CE41fFb1DdEF4ca288B57Cf9966091"
RPC_URL="https://eth-sepolia.g.alchemy.com/v2/your_alchemy_api_key"

# Server Settings
PORT=3001
NODE_ENV="development"
ALLOWED_ORIGINS="http://localhost:3000"
